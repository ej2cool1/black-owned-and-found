generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  password  String

  businesses Business[]
}

model Business {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  city        String?
  state       String
  description String?
  website     String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  address     String?

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  @@unique([name, city, state])
}
